# The photographs of the paper notebook are deliberately NOT in version
# control: the inside cover carries a home address. Keep them locally if
# you want to check a transcription against the page, but they stay out
# of the repository. data/notebook-source.yaml records what was on them.
notebook/
*.jpg
*.jpeg
*.heic

# In build/, keep the generated LaTeX and the PDFs; drop everything else
# TeX leaves behind (.aux, .log, .out, the copied .cls). The published
# PDFs carry their display names ("Fancy Mandolin Chords and Their
# Voicings.pdf"), which is what the README links to and what the cover's
# QR code leads someone to download.
build/*
!build/*.tex
!build/*.pdf

*.aux
*.log
*.out
*.synctex.gz
.DS_Store
__pycache__/
*.pyc
